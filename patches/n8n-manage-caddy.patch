+  // PROXY_MODE=caddy: VPS dung chung 1 Caddy voi cac app khac (vps-ai-management).
+  // Agent chi ghi site file vao CADDY_SITES_DIR va reload Caddy; Caddy tu cap +
+  // gia han Let's Encrypt. DNS chua tro ve VPS -> chung chi tu ky (tls internal)
+  // de khong xin cert lien tuc (NXDOMAIN, rate limit); doi domain / reinstall sau
+  // khi tro DNS se chuyen sang Let's Encrypt. Mac dinh: nginx + certbot.
+  private isCaddyMode(): boolean {
+    return (process.env.PROXY_MODE || 'nginx').toLowerCase() === 'caddy';
+  }
+
+  private caddySitePath(): string {
+    const dir = process.env.CADDY_SITES_DIR || '/etc/vps-ai/caddy/sites';
+    return path.join(dir, 'n8n.caddy');
+  }
+
+  // A record cua domain (qua 1.1.1.1) co trung IP cua VPS khong
+  private async dnsPointsHere(domain: string): Promise<boolean> {
+    try {
+      const { stdout: resolved } = await this.shellService.execute(
+        `dig +short A ${domain} @1.1.1.1 || true`,
+      );
+      const { stdout: local } = await this.shellService.execute('hostname -I || true');
+      const serverIps = new Set(local.split(/\s+/).filter(Boolean));
+      if (process.env.SERVER_IP) serverIps.add(process.env.SERVER_IP.trim());
+      return resolved.split(/\s+/).some((ip) => serverIps.has(ip));
+    } catch {
+      return false;
+    }
+  }
+
+  private createCaddySite(domain: string, tlsDirective: string): string {
+    return `# Managed by n8n-agent (PROXY_MODE=caddy) — do not edit, rewritten on install/change-domain
+${domain} {
+    ${tlsDirective}
+
+    request_body {
+        max_size 100MB
+    }
+
+    handle_path /nocodb/* {
+        reverse_proxy 127.0.0.1:8080
+    }
+
+    handle /mcp/* {
+        reverse_proxy 127.0.0.1:5678 {
+            flush_interval -1
+            transport http {
+                read_timeout 1h
+                write_timeout 1h
+            }
+        }
+    }
+
+    handle {
+        reverse_proxy 127.0.0.1:5678 {
+            flush_interval -1
+        }
+    }
+}
+`;
+  }
+
+  private async setupCaddy(domain: string, email: string) {
+    const sitePath = this.caddySitePath();
+    await fs.mkdir(path.dirname(sitePath), { recursive: true });
+    const dnsReady = await this.dnsPointsHere(domain);
+    const tlsDirective = dnsReady ? `tls ${email}` : 'tls internal';
+    await fs.writeFile(sitePath, this.createCaddySite(domain, tlsDirective));
+    this.logger.log(`Caddy site file written at ${sitePath} (${tlsDirective})`);
+    if (!dnsReady) {
+      this.logger.warn(
+        `DNS for ${domain} does not point to this server — using a self-signed certificate. ` +
+          `Point DNS here, then change domain / reinstall to switch to Let's Encrypt.`,
+      );
+    }
+    await this.shellService.execute('systemctl reload caddy || systemctl restart caddy');
+    this.logger.log('Caddy reloaded.');
+  }
+
