#!/bin/bash
# =============================================================================
# vps-ai — xem thong tin / trang thai cac app do vps-ai-management cai
#
#   vps-ai info                 URL, token, API key cua tung app
#   vps-ai status               trang thai systemd/docker
#   vps-ai restart <app|all>    hermes | n8n | openclaw | caddy | all
#   vps-ai logs <app>           journalctl -f cua app
#   vps-ai reload-caddy         sinh lai env + validate + restart Caddy
#   vps-ai add <app...>         cai them app (chay lai install.sh voi cau hinh hien tai)
#   vps-ai disable <app>        tat han app (stop + disable systemd, n8n: compose down,
#                               go site Caddy) de tiet kiem RAM; du lieu giu nguyen
#   vps-ai enable <app>         bat lai app da disable
#   vps-ai apps                 trang thai enabled/disabled cua tung app
# =============================================================================
set -uo pipefail

ENV_FILE="/opt/vps-ai/.env"
SRC_DIR="/opt/vps-ai/src"

get() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 0
  awk -F= -v k="$key" '$1 == k { sub("^[^=]*=", ""); print; exit }' "$file"
}

apps() { get "$ENV_FILE" INSTALLED_APPS | tr ',' ' '; }
has_app() { [[ " $(apps) " == *" $1 "* ]]; }
disabled_apps() { get "$ENV_FILE" DISABLED_APPS | tr ',' ' '; }
is_disabled() { [[ " $(disabled_apps) " == *" $1 "* ]]; }
unit_exists() { systemctl cat "$1" &>/dev/null; }

SITES_DIR="/etc/vps-ai/caddy/sites"
SITES_OFF_DIR="/etc/vps-ai/caddy/sites-disabled"

# set_env_key <key> <value> — ghi de/them 1 dong trong /opt/vps-ai/.env
set_env_key() {
  local key="$1" value="$2" tmp
  tmp="$(mktemp)"
  if grep -q "^${key}=" "$ENV_FILE"; then
    awk -v k="$key" -v v="$value" -F= '$1 == k { print k "=" v; next } { print }' "$ENV_FILE" > "$tmp"
  else
    cat "$ENV_FILE" > "$tmp"; echo "${key}=${value}" >> "$tmp"
  fi
  cat "$tmp" > "$ENV_FILE"; rm -f "$tmp"
}

svc() {
  local s
  s="$(systemctl is-active "$1" 2>/dev/null)"
  printf "    %-22s %s\n" "$1" "${s:-unknown}"
}

cmd_info() {
  local ip key
  ip="$(get "$ENV_FILE" SERVER_IP)"
  key="$(get "$ENV_FILE" MGMT_API_KEY)"
  echo "============================================================"
  echo "  vps-ai-management $(get "$ENV_FILE" VPS_AI_VERSION)"
  echo "============================================================"
  echo "  Ten mien goc : $(get "$ENV_FILE" BASE_DOMAIN)"
  echo "  Server IP    : ${ip}"
  echo "  MGMT API key : ${key}   (dung chung cho moi management API)"
  echo "  vps-ai API   : http://${ip}:9990   (bat/tat app: POST /api/apps/<app>/disable|enable)"
  echo ""
  if has_app hermes; then
    local d tls
    d="$(get /opt/hermes/.env DOMAIN)"
    tls="$(get /opt/hermes/.env CADDY_TLS)"
    echo "  [Hermes Agent]$(is_disabled hermes && echo "  — DISABLED (vps-ai enable hermes)")"
    echo "    Dashboard   : https://${d}/?token=$(get /opt/hermes/.env HERMES_AUTH_TOKEN)"
    echo "    Mgmt API    : http://${ip}:9997   (Authorization: Bearer <MGMT API key>)"
    echo "    SSL         : $([[ -z "$tls" ]] && echo "Let's Encrypt" || echo "tu ky (DNS chua tro khi cai)")"
    echo ""
  fi
  if has_app openclaw; then
    local d tls
    d="$(get /opt/openclaw/.env DOMAIN)"
    tls="$(get /opt/openclaw/.env CADDY_TLS)"
    echo "  [OpenClaw]$(is_disabled openclaw && echo "  — DISABLED (vps-ai enable openclaw)")"
    echo "    Gateway     : https://${d#http://}"
    echo "    Pair        : http://${ip}:9998/pair?token=$(get /opt/openclaw/.env OPENCLAW_GATEWAY_TOKEN)"
    echo "    Mgmt API    : http://${ip}:9998   (Authorization: Bearer <MGMT API key>)"
    echo "    SSL         : $([[ -z "$tls" ]] && echo "Let's Encrypt" || echo "tu ky (DNS chua tro khi cai)")"
    echo ""
  fi
  if has_app n8n; then
    local d
    d="$(get /opt/n8n/.env N8N_HOST)"
    local n8n_tls
    n8n_tls="$(grep -E '^[[:space:]]*tls ' /etc/vps-ai/caddy/sites/n8n.caddy 2>/dev/null | head -1 | xargs)"
    echo "  [n8n]$(is_disabled n8n && echo "  — DISABLED (vps-ai enable n8n)")"
    echo "    n8n         : https://${d:-<dang cai>}"
    echo "    SSL         : $([[ "$n8n_tls" == "tls internal" ]] && echo "tu ky (DNS chua tro khi cai — PATCH /api/n8n/change-domain sau khi tro DNS)" || echo "Let's Encrypt")"
    echo "    NocoDB      : https://${d:-<dang cai>}/nocodb/"
    echo "    Agent API   : http://${ip}:7071   (header tng-api-key: <MGMT API key>, IP whitelist)"
    echo ""
  fi
  echo "  DNS: tro A record cua moi ten mien tren ve ${ip} (hoac wildcard *.$(get "$ENV_FILE" BASE_DOMAIN))"
  echo "  Log cai dat: /var/log/vps-ai-install.log"
  echo "============================================================"
}

cmd_status() {
  echo "  [chung]"
  svc vps-ai-mgmt
  svc caddy
  svc fail2ban
  if has_app hermes; then
    echo "  [hermes]$(is_disabled hermes && echo "  — DISABLED")"
    for s in hermes-mgmt hermes-gateway hermes-dashboard hermes-rag; do
      unit_exists "${s}.service" && svc "$s"
    done
  fi
  if has_app openclaw; then
    echo "  [openclaw]$(is_disabled openclaw && echo "  — DISABLED")"
    svc openclaw
    svc openclaw-mgmt
  fi
  if has_app n8n; then
    echo "  [n8n]$(is_disabled n8n && echo "  — DISABLED")"
    svc n8n-agent
    svc docker
    if [[ -f /opt/n8n/docker-compose.yml ]]; then
      (cd /opt/n8n && docker compose ps --format '    {{.Service}}  {{.State}}  {{.Status}}' 2>/dev/null)
    fi
  fi
}

units_of() {
  case "$1" in
    hermes)   echo "hermes-mgmt hermes-gateway hermes-dashboard $(unit_exists hermes-rag.service && echo hermes-rag)" ;;
    openclaw) echo "openclaw openclaw-mgmt" ;;
    n8n)      echo "n8n-agent" ;;
    caddy)    echo "caddy" ;;
    *)        echo "" ;;
  esac
}

cmd_restart() {
  local target="${1:-}" a
  [[ -n "$target" ]] || { echo "Usage: vps-ai restart <hermes|n8n|openclaw|caddy|all>"; exit 1; }
  if [[ "$target" == "all" ]]; then
    for a in $(apps); do cmd_restart "$a"; done
    cmd_restart caddy
    return
  fi
  local units
  units="$(units_of "$target")"
  [[ -n "$units" ]] || { echo "App khong hop le: $target"; exit 1; }
  if is_disabled "$target"; then echo "Bo qua ${target}: dang disabled (vps-ai enable ${target})"; return 0; fi
  # shellcheck disable=SC2086
  systemctl restart $units && echo "Da restart: $units"
  if [[ "$target" == "n8n" && -f /opt/n8n/docker-compose.yml ]]; then
    (cd /opt/n8n && docker compose restart) && echo "Da restart docker compose /opt/n8n"
  fi
}

cmd_logs() {
  local units u args=()
  units="$(units_of "${1:-}")"
  [[ -n "$units" ]] || { echo "Usage: vps-ai logs <hermes|n8n|openclaw|caddy>"; exit 1; }
  for u in $units; do args+=(-u "$u"); done
  exec journalctl "${args[@]}" -f -n 100
}

cmd_reload_caddy() {
  local out
  /usr/local/sbin/vps-ai-caddy-env
  # Log validate chi in ra khi loi (tranh lan output cua API bat/tat)
  out="$( ( set -a; . /run/vps-ai/caddy.env; caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile ) 2>&1 )" \
    || { echo "$out" | tail -5 >&2; return 1; }
  systemctl restart caddy && echo "Caddy da restart"
}

# quiet <cmd...> — chay lenh, chi in output khi that bai
quiet() {
  local out
  out="$("$@" 2>&1)" || { echo "$out" | tail -15 >&2; return 1; }
}

# Toan bo unit can tat de app khong tu chay lai sau reboot. hermes.target Wants=
# cac service Hermes nen phai disable ca target.
app_units_all() {
  local u
  case "$1" in
    hermes)
      echo "hermes.target hermes-gateway.service hermes-dashboard.service hermes-mgmt.service"
      for u in hermes-rag.service hermes-openviking.service; do unit_exists "$u" && echo "$u"; done ;;
    openclaw) echo "openclaw.service openclaw-mgmt.service" ;;
    n8n)      echo "n8n-agent.service n8n-agent-update.timer" ;;
  esac
}

require_app() {
  local app="${1:-}"
  case "$app" in hermes|n8n|openclaw) ;; *) echo "App khong hop le: '${app}' (hermes | n8n | openclaw)" >&2; exit 2 ;; esac
  has_app "$app" || { echo "App '${app}' chua duoc cai tren VPS nay" >&2; exit 3; }
}

cmd_disable() {
  local app="${1:-}" units
  require_app "$app"
  # shellcheck disable=SC2046
  units="$(app_units_all "$app" | xargs)"
  echo "Disable ${app}: ${units}"
  # shellcheck disable=SC2086
  systemctl disable --now $units >/dev/null 2>&1 || true
  # Gateway Hermes thoat ma != 0 khi nhan SIGTERM -> xoa trang thai "failed"
  # shellcheck disable=SC2086
  systemctl reset-failed $units >/dev/null 2>&1 || true
  if [[ "$app" == "n8n" && -f /opt/n8n/docker-compose.yml ]]; then
    # down (khong -v): xoa container, GIU volume du lieu. Khong dung `stop` vi
    # nocodb co restart: always se tu chay lai khi docker khoi dong lai.
    quiet docker compose -f /opt/n8n/docker-compose.yml down || { echo "LOI: docker compose down that bai" >&2; exit 1; }
  fi
  mkdir -p "$SITES_OFF_DIR"
  [[ -f "${SITES_DIR}/${app}.caddy" ]] && mv -f "${SITES_DIR}/${app}.caddy" "${SITES_OFF_DIR}/${app}.caddy"
  is_disabled "$app" || set_env_key DISABLED_APPS "$(echo "$(disabled_apps) $app" | xargs | tr ' ' ',')"
  cmd_reload_caddy >/dev/null || echo "WARN: reload Caddy loi — vps-ai reload-caddy" >&2
  echo "Da disable ${app} (du lieu giu nguyen; bat lai: vps-ai enable ${app})"
}

cmd_enable() {
  local app="${1:-}" units
  require_app "$app"
  units="$(app_units_all "$app" | xargs)"
  echo "Enable ${app}: ${units}"
  if [[ "$app" == "n8n" && -f /opt/n8n/docker-compose.yml ]]; then
    systemctl start docker
    quiet docker compose -f /opt/n8n/docker-compose.yml up -d || { echo "LOI: docker compose up that bai" >&2; exit 1; }
  fi
  # shellcheck disable=SC2086
  systemctl enable $units >/dev/null 2>&1
  # shellcheck disable=SC2086
  systemctl start $units || { echo "LOI: start ${units} that bai — journalctl -u ..." >&2; exit 1; }
  [[ -f "${SITES_OFF_DIR}/${app}.caddy" ]] && mv -f "${SITES_OFF_DIR}/${app}.caddy" "${SITES_DIR}/${app}.caddy"
  set_env_key DISABLED_APPS "$(disabled_apps | tr ' ' '\n' | grep -vx "$app" | xargs | tr ' ' ',')"
  cmd_reload_caddy >/dev/null || echo "WARN: reload Caddy loi — vps-ai reload-caddy" >&2
  echo "Da enable ${app}"
}

cmd_apps() {
  local a
  for a in $(apps); do
    printf "  %-10s %s\n" "$a" "$(is_disabled "$a" && echo disabled || echo enabled)"
  done
}

cmd_add() {
  [[ $# -gt 0 ]] || { echo "Usage: vps-ai add <hermes|n8n|openclaw>..."; exit 1; }
  local flags=() a
  for a in "$@"; do flags+=("--${a}"); done
  exec bash "${SRC_DIR}/install.sh" --domain "$(get "$ENV_FILE" BASE_DOMAIN)" "${flags[@]}"
}

case "${1:-info}" in
  info)          cmd_info ;;
  status)        cmd_status ;;
  restart)       shift; cmd_restart "$@" ;;
  logs)          shift; cmd_logs "$@" ;;
  reload-caddy)  cmd_reload_caddy || exit 1 ;;
  add)           shift; cmd_add "$@" ;;
  disable)       shift; cmd_disable "$@" ;;
  enable)        shift; cmd_enable "$@" ;;
  apps)          cmd_apps ;;
  -h|--help|help) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)             echo "Lenh khong ro: $1 (xem: vps-ai help)"; exit 1 ;;
esac
